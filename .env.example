# Luxtronik controller. Firmware before 1.76 uses port 8888; 1.76 and later use 8889.
LUXTRONIK_HOST=192.168.1.30
LUXTRONIK_PORT=8888
# Controller web login. The TCP data port does not use these.
LUXTRONIK_USER_PASSWORD=
LUXTRONIK_EXPERT_PASSWORD=
# How often the heat pump is read and the pages reload, in seconds.
POLL_INTERVAL_SECONDS=60

# sqlite URL. A postgresql:// URL is enough to move to PostgreSQL later.
DATABASE_URL=sqlite:///data/luxtronik_data.db

# Synthetic telemetry when the heat pump is not on the LAN.
DEMO_MODE=false

# openai, gemini, or anthropic. AI_MODEL overrides the provider default.
AI_PROVIDER=openai
AI_MODEL=
ADVICE_WINDOW_HOURS=24
SHORT_CYCLE_SECONDS=600

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
